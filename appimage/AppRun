#!/bin/sh
# Pornirea lui Lanruj din AppImage. Pachetul are tot: glibc și încărcătorul ei (ld-linux), GTK, libadwaita,
# fontconfig. Din sistem se folosesc doar nucleul, ecranul (Wayland sau X11), fonturile și setările lor.
# Așa merge pe orice distribuție, oricât de veche ar fi glibc-ul ei.
HERE="$(dirname "$(readlink -f "$0")")"
LIB="$HERE/usr/lib"

export XDG_DATA_DIRS="$HERE/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
# Fără placa video: driverele grafice ale sistemului sunt legate de glibc-ul sistemului și nu se pot
# amesteca cu cea din pachet. Pentru un jurnal, desenarea cu procesorul ajunge.
export GSK_RENDERER=cairo
export GDK_DISABLE=gl,vulkan

# Configurația tastaturii din pachet, doar dacă sistemul nu o are.
[ -d /usr/share/X11/xkb ] || export XKB_CONFIG_ROOT="$HERE/usr/share/X11/xkb"
# Configurația fonturilor e mereu cea din pachet: a sistemului poate fi scrisă pentru un fontconfig mai nou
# decât cel din pachet (de exemplu pe Arch), care ar umple jurnalul cu avertismente. Cea din pachet citește
# tot fonturile sistemului (/usr/share/fonts, ~/.local/share/fonts) și setările din ~/.config/fontconfig.
export FONTCONFIG_FILE="$HERE/etc/fonts/fonts.conf"
# conf.d (inclus fără cale în fonts.conf) se caută aici, nu în /etc/fonts
export FONTCONFIG_PATH="$HERE/etc/fonts"

# Lista încărcătoarelor de imagini (SVG pentru iconițe) are căi absolute; se scrie la fiecare pornire.
CACHE="${XDG_RUNTIME_DIR:-/tmp}/lanruj-appimage-$(id -u)"
mkdir -p "$CACHE"
sed "s#@APPDIR@#$HERE#g" "$LIB/gdk-pixbuf-2.0/loaders.cache.in" > "$CACHE/loaders.cache"
export GDK_PIXBUF_MODULE_FILE="$CACHE/loaders.cache"

# Programul pornește prin încărcătorul din pachet, cu bibliotecile din pachet.
exec "$LIB/ld-linux-x86-64.so.2" --library-path "$LIB" "$HERE/usr/bin/lanruj" "$@"
